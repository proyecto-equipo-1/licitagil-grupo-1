# 🌐 Variables de entorno para Selenium Tests

# 🖥️ URLs de la aplicación
BASE_URL=http://localhost:5173
API_URL=http://localhost:3000

# 🌐 Configuración del navegador
BROWSER=chrome
HEADLESS=false

# ⏱️ Timeouts (en milisegundos)
TIMEOUT=30000
IMPLICIT_WAIT=10000
PAGE_LOAD_TIMEOUT=30000

# 📊 Configuración de reportes
ALLURE_RESULTS_DIR=allure-results
SCREENSHOTS_DIR=screenshots

# 🧪 Configuración de pruebas
RETRY_COUNT=2
PARALLEL_TESTS=false

# 🔧 Variables de aplicación para testing
TEST_USER_EMAIL=selenium-test@licitagil.com
TEST_USER_PASSWORD=SeleniumTest2024!
TEST_DATA_PREFIX=SeleniumE2E

# 📱 Configuración de dispositivos (opcional)
WINDOW_WIDTH=1920
WINDOW_HEIGHT=1080

# 🚀 CI/CD Configuration
CI=false
JENKINS_BUILD=false