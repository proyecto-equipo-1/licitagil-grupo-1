{
  "name": "licitagil-selenium-tests",
  "version": "1.0.0",
  "description": "Pruebas E2E con Selenium WebDriver para LicitAgil",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:chrome": "jest --testNamePattern=chrome",
    "test:firefox": "jest --testNamePattern=firefox",
    "test:edge": "BROWSER=edge jest",
    "test:headless": "HEADLESS=true jest",
    "test:visible": "HEADLESS=false jest",
    "test:crud": "jest crud-completo.test.js",
    "test:search": "jest busqueda-filtros.test.js",
    "test:forms": "jest validacion-formularios.test.js",
    "test:smoke": "jest smoke.test.js",
    "test:basic": "jest basic.test.js",
    "test:regression": "jest --testPathPattern=regression",
    "test:ci": "CI=true HEADLESS=true jest --coverage --reporters=default --reporters=jest-junit",
    "test:smoke:ci": "CI=true HEADLESS=true jest tests/smoke.test.js --reporters=default --reporters=jest-junit",
    "test:basic:ci": "CI=true HEADLESS=true jest basic.test.js --reporters=default",
    "setup": "node setup-webdrivers.js",
    "setup:drivers": "node setup-webdrivers.js",
    "clean": "rimraf screenshots/ videos/ reports/",
    "report": "npx allure generate allure-results --clean -o allure-report && npx allure open allure-report"
  },
  "keywords": [
    "selenium",
    "webdriver",
    "e2e",
    "testing",
    "automation",
    "javascript",
    "jest"
  ],
  "author": "Equipo LicitAgil",
  "license": "MIT",
  "dependencies": {
    "allure-commandline": "^2.24.1",
    "allure-jest": "^2.10.0",
    "chromedriver": "^142.0.3",
    "dotenv": "^16.3.1",
    "edgedriver": "^6.2.0",
    "fs-extra": "^11.1.1",
    "geckodriver": "^4.2.1",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "moment": "^2.29.4",
    "rimraf": "^5.0.5",
    "selenium-webdriver": "^4.15.0",
    "webdriver-manager": "^12.1.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/selenium-webdriver": "^4.1.20",
    "jest-junit": "^16.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "setupFilesAfterEnv": [
      "<rootDir>/config/jest.setup.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/e2e/**/*.test.js"
    ],
    "collectCoverage": false,
    "verbose": true,
    "reporters": [
      "default"
    ]
  }
}
