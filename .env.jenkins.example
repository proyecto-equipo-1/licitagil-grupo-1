# ========================================
# Variables de Entorno para Jenkins CI/CD
# ========================================
# Este archivo contiene las variables de entorno necesarias
# para el pipeline de Jenkins. NO commitear con valores reales.

# ========================================
# BASE DE DATOS
# ========================================
DATABASE_URL=postgresql://usuario:password@host:5432/database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=licitagil

# ========================================
# SERVIDOR API
# ========================================
NODE_ENV=production
PORT=3000
API_PORT=3000
JWT_SECRET=change-this-jwt-secret-in-production

# ========================================
# SERVIDOR WEB
# ========================================
WEB_PORT=80
VITE_API_URL=http://localhost:3000

# ========================================
# JENKINS
# ========================================
# URL de Jenkins (usar ngrok si es local)
JENKINS_URL=http://localhost:8080
# URL para webhooks (usar ngrok si es local)
WEBHOOK_URL=http://localhost:8080/github-webhook/

# ========================================
# GITHUB
# ========================================
# Token de GitHub para acceso al repositorio
# Crear en: GitHub → Settings → Developer settings → Personal access tokens
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_REPO=https://github.com/proyecto-equipo-1/licitagil-grupo-1.git

# ========================================
# SLACK
# ========================================
# Webhook URL de Slack
# Crear en: https://api.slack.com/apps
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#licitagil-notifications

# ========================================
# DOCKER
# ========================================
DOCKER_REGISTRY=docker.io
IMAGE_NAME=licitagil
DOCKER_USERNAME=your_username
DOCKER_PASSWORD=your_password

# ========================================
# AWS (Para deploy a AWS Amplify)
# ========================================
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_DEFAULT_REGION=us-east-1

# Amplify App ID (ya configurado en el proyecto)
AMPLIFY_APP_ID=d386d94bix0hzl
AMPLIFY_ENVIRONMENT=dev
AMPLIFY_API_ENDPOINT=https://mqru1bnmg2.execute-api.us-east-1.amazonaws.com/dev

# ========================================
# ARCHIVOS
# ========================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ========================================
# CORS
# ========================================
CORS_ORIGIN=http://localhost:5173

# ========================================
# LOGS
# ========================================
LOG_LEVEL=info
