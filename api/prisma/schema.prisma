generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  Administrador
  Adquisiciones
  Supervisor
  Funcionario
  Postulante
}

enum EstadoLicitacion {
  Borrador
  PendienteAprobacion
  Aprobada
  Abierta
  En_revision
  Cerrada
  Rechazada
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   // Hash de la contraseña con bcrypt
  name      String?
  rol       Rol      @default(Postulante)
  
  // Relación con Departamento (opcional para Adquisiciones y Postulante)
  departamentoId Int?
  departamento   Departamento? @relation(fields: [departamentoId], references: [id])
  
  // Relaciones con Licitaciones
  licitacionesCreadas   Licitacion[] @relation("CreadorLicitacion")
  licitacionesAprobadas Licitacion[] @relation("AprobadorLicitacion")
  
  // Relación con Auditoría
  auditLogs             AuditLog[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Departamento {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  codigo      String   @unique  // Ej: "TI", "RRHH", "FIN"
  descripcion String?
  
  // Relaciones
  usuarios     User[]
  licitaciones Licitacion[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Licitacion {
  id             Int               @id @default(autoincrement())
  titulo         String
  descripcion    String
  estado         EstadoLicitacion  @default(Borrador)
  
  // Relación con Departamento (null para licitaciones de Adquisiciones)
  departamentoId Int?
  departamento   Departamento? @relation(fields: [departamentoId], references: [id])
  
  // Relación con Usuario Creador
  creadorId Int
  creador   User @relation("CreadorLicitacion", fields: [creadorId], references: [id])
  
  // Relación con Usuario Aprobador (Supervisor o Adquisiciones)
  aprobadorId    Int?
  aprobador      User? @relation("AprobadorLicitacion", fields: [aprobadorId], references: [id])
  
  fechaCreacion   DateTime  @default(now())
  fechaCierre     DateTime
  fechaAprobacion DateTime?
  
  pdfPath         String?   // Ruta del PDF subido
  pdfOriginalName String?   // Nombre original del archivo subido
  
  // Validación automática de PDF (de testing/SCRUM-10)
  estadoValidacion   EstadoValidacion  @default(Borrador)
  seccionesFaltantes String[]          @default([])  // Array de secciones faltantes
  fechaValidacion    DateTime?         // Cuándo se validó el PDF
  mensajeValidacion  String?           // Mensaje detallado de la validación
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EstadoValidacion {
  Borrador      // Sin PDF o no validado
  Incompleta    // PDF cargado pero faltan secciones
  Completa      // Todas las secciones presentes
}

enum TipoAccion {
  CREAR
  EDITAR
  ELIMINAR
  CAMBIO_ESTADO
  LOGIN
  LOGOUT
}

model AuditLog {
  id              Int         @id @default(autoincrement())
  
  // Quién realizó la acción
  usuarioId       Int
  usuario         User        @relation(fields: [usuarioId], references: [id])
  
  // Qué acción se realizó
  accion          TipoAccion
  
  // Sobre qué entidad (ej: "Licitacion", "User", "Departamento")
  entidad         String
  entidadId       Int?        // ID de la entidad afectada (null para LOGIN/LOGOUT)
  
  // Detalles del cambio (JSON con valores antes/después)
  detallesAntes   Json?       // Estado anterior (para EDITAR, ELIMINAR, CAMBIO_ESTADO)
  detallesDespues Json?       // Estado nuevo (para CREAR, EDITAR, CAMBIO_ESTADO)
  
  // Cuándo ocurrió
  createdAt       DateTime    @default(now())
  
  @@index([usuarioId])
  @@index([entidad, entidadId])
  @@index([createdAt])
}
