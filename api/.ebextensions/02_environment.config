option_settings:
  # Environment Variables
  # NOTA: Es más seguro configurar estas variables en AWS Console después del despliegue
  # AWS Console → Elastic Beanstalk → Environment → Configuration → Software → Environment properties
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    PORT: 8080
    # DATABASE_URL: Configúralo en AWS Console (no lo dejes hardcoded aquí)
    # JWT_SECRET: Configúralo en AWS Console (genera uno seguro)
    
  # VPC Configuration
  # INSTRUCCIONES PARA OBTENER ESTOS IDs:
  # 1. Ve a AWS Console → RDS → Databases → licitagil-db
  # 2. Tab "Connectivity & security"
  # 3. Anota: VPC ID, Subnets (al menos 2), Security Groups
  # 4. Reemplaza los valores xxx abajo con los valores reales
  aws:ec2:vpc:
    VPCId: vpc-0daa02ee51df417eb
    Subnets: subnet-02fb58e7f2d6c9b4a, subnet-0d333045a2ef42aa2, subnet-0c1438c5f0c5f9fd0, subnet-070e4a333f831e9ba, subnet-0fc9d77aca4c77433, subnet-01a2f2109d99d5543
    ELBSubnets: subnet-02fb58e7f2d6c9b4a, subnet-0d333045a2ef42aa2, subnet-0c1438c5f0c5f9fd0, subnet-070e4a333f831e9ba, subnet-0fc9d77aca4c77433, subnet-01a2f2109d99d5543
    ELBScheme: public
    AssociatePublicIpAddress: true
    
  # Security Group
  # Este SG debe permitir:
  # - Inbound: HTTP (80), HTTPS (443) desde 0.0.0.0/0
  # - Outbound: PostgreSQL (5432) hacia el Security Group de RDS
  aws:autoscaling:launchconfiguration:
    SecurityGroups: sg-00e5160f98ceb24d0
