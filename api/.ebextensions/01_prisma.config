commands:
  01_install_prisma:
    command: "npm install -g prisma"
  02_generate_prisma:
    command: "cd /var/app/current && npx prisma generate"
    ignoreErrors: true
  03_create_directories:
    command: "mkdir -p /var/app/current/dist/uploads /var/app/current/dist/templates"
    ignoreErrors: true
  04_copy_templates:
    command: "cp /var/app/current/templates/*.pdf /var/app/current/dist/templates/ 2>/dev/null || true"
    ignoreErrors: true
