option_settings:
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    PORT: 8080
  aws:autoscaling:launchconfiguration:
    InstanceType: t3.micro
    IamInstanceProfile: aws-elasticbeanstalk-ec2-role
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: nginx

files:
  "/tmp/set_npm_script.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # El comando de inicio se maneja via package.json script "start"

container_commands:
  01_set_start_command:
    command: "echo 'Using npm start from package.json'"
